{
  "category": "development",
  "tags": ["vue", "go", "template"],
  "apiVersion": 2,
  "id": "vue-go-plugin",
  "name": "Vue + Go Plugin",
  "version": "0.1.0",
  "description": "A build-first MinCode visual plugin using Vue 3, Element Plus, and an isolated Go process.",
  "author": "Your Name",
  "platforms": ["__PLATFORM__"],
  "capabilities": ["commands", "ui"],
  "runtime": {
    "type": "process",
    "entry": "bin/__BINARY__",
    "args": []
  },
  "contributes": {
    "actions": [
      {
        "id": "greeting.create",
        "risk": "read",
        "uiCallable": true,
        "maxPayloadBytes": 4096,
        "description": "Return a greeting generated by the Go plugin process.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Greeting target, 1-80 characters"
            }
          },
          "required": ["name"],
          "additionalProperties": false
        },
        "examples": [
          { "name": "MinCode" }
        ]
      }
    ],
    "views": [
      {
        "id": "main",
        "title": "Vue + Go Plugin",
        "titleLocalized": {"zh": "Vue + Go 插件", "en": "Vue + Go Plugin"},
        "titleLocalized": {
          "zh": "Vue + Go 插件",
          "en": "Vue + Go Plugin"
        },
        "entry": "ui/index.html",
        "icon": "data-analysis"
      }
    ],
    "commands": [
      {
        "id": "vue-go-plugin.open",
        "title": "Open Vue + Go Plugin",
        "titleLocalized": {"zh": "打开Vue + Go 插件", "en": "Open Vue + Go Plugin"},
        "titleLocalized": {
          "zh": "打开 Vue + Go 插件",
          "en": "Open Vue + Go Plugin"
        },
        "description": "Open the template workspace view.",
        "keywords": ["plugin", "vue", "go"],
        "target": {
          "type": "view",
          "viewId": "main"
        }
      }
    ]
  }
}
