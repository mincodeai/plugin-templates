{
  "id": "rust-plugin",
  "name": "Rust Process Plugin",
  "version": "0.1.0",
  "apiVersion": 2,
  "category": "development",
  "tags": ["rust", "template"],
  "description": "A language-neutral JSON-RPC process plugin written in Rust. No MinCode SDK required.",
